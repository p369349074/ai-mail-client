# Shared deployment defaults. Copy to .env for local overrides.
# Do not commit real passwords, OAuth tokens, API keys, or mailbox credentials.

APP_ENV=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# Backend
DATABASE_URL=sqlite:///./dev.db
# Production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-local-env
CORS_ORIGINS=http://localhost:5173
DEFAULT_USER_EMAIL=local@example.invalid
DEFAULT_USER_DISPLAY_NAME=Local User
MAIL_CONNECT_TIMEOUT_SECONDS=10

# Mail sync safety limits
MAX_INITIAL_DAYS=30
MAX_INITIAL_MESSAGES=1000
MAX_BODY_CACHE_MB=1024
MAX_ATTACHMENT_CACHE_MB=700
DISK_PAUSE_THRESHOLD=85

# External AI provider, called only on demand.
AI_PROVIDER=
AI_API_KEY=
